# Normalize text files to LF in the repository
* text=auto eol=lf

*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.yml text eol=lf
*.gdshader text eol=lf
*.svg text eol=lf
*.uid text eol=lf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.wav binary
*.ogg binary
*.glb binary
*.ttf binary
*.otf binary
