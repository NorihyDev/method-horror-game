# Godot editor/import cache
.godot/
game/.godot/
*.translation
# Godot generates these on export/debug
game/android/build/
game/android/.build_version
*.tmp

# Build outputs
build/
builds/
dist/
exports/
*.apk
*.aab
*.ipa
*.pck
*.zip
*.tpz

# Signing material and secrets — never commit
*.keystore
*.jks
*.p12
*.pem
*.key
*.mobileprovision
export_credentials.cfg
.env
.env.*
!.env.example
secrets/

# Backend
services/lobby/node_modules/
services/lobby/data/
services/lobby/*.sqlite
services/lobby/*.sqlite-*
coverage/

# Tooling
.venv/
__pycache__/
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Character sources: the face photo stays private, work files stay local
tools/characters/**/face_src.*
tools/characters/**/face_flat.png
tools/characters/**/face_mask.png
*.blend
*.blend1

# Third-party source packs (licences vary; converted models live elsewhere)
game/assets/monster-pack/
# Converted monsters are committed (credited in THIRD_PARTY_NOTICES.md),
# except Gravvok, whose itch.io page states no licence: it is built into the
# release downloads from the maintainer's machine but not published here.
game/assets/monsters/gravvok/
