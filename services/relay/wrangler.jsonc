{
  // METHOD HORROR relay: one Durable Object per private room (Workers Free plan).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "method-horror-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  // The Free plan supports only SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "observability": { "enabled": false }
}
