# Copy to .env (never commit .env). All secrets must be >= 32 random characters
# in production, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.

NODE_ENV=development
LOBBY_HOST=127.0.0.1
LOBBY_PORT=8787
LOBBY_DB_PATH=data/lobby.sqlite

# Shared with dedicated game servers (tickets) — keep identical on both sides.
METHOD_TICKET_SECRET=
# Authenticates game server -> lobby calls (status, match results).
METHOD_SERVER_SECRET=

# Address clients connect to for game servers (public IP/DNS in deployment).
PUBLIC_GAME_HOST=127.0.0.1
METHOD_PROTOCOL_VERSION=1
TICKET_TTL_SECONDS=300
SESSION_TTL_DAYS=30
ROOM_IDLE_MINUTES=15

# Single-host mode: spawn one headless Godot server per room.
SPAWN_LOCAL_SERVERS=1
GODOT_BIN=/opt/godot/Godot_v4.7.2-stable_linux.x86_64
GAME_PATH=../../game
SERVER_PORT_MIN=24600
SERVER_PORT_MAX=24699
LOBBY_URL_FOR_SERVERS=http://127.0.0.1:8787

# Set to 1 only behind a reverse proxy you control (uses X-Forwarded-For).
TRUST_PROXY=0
